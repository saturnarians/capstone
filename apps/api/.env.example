# Copy to apps/api/.env. Never commit the real file.
NODE_ENV=development
PORT=5000
# Transactions require a replica set. MongoDB Atlas also works.
MONGODB_URI=mongodb://127.0.0.1:27017/small_business_crm?replicaSet=rs0
# Optional comma-separated IP resolvers for an Atlas mongodb+srv URI when the
# machine DNS resolver cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT=30
# Only change to the exact number of trusted reverse proxies in your deployment.
TRUST_PROXY_HOPS=0
